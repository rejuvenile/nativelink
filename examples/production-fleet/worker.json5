{
  "stores": [
    {
      "name": "AC_MAIN_STORE",
      "fast_slow": {
        "fast": {
          // In-memory AC fast tier: AC entries are tiny (~100-1000 bytes each).
          // 100 MB / 100K cap holds ~100K entries, well above any realistic
          // in-flight slow-write window. Workers don't read AC; the fast tier
          // serves as the synchronous ack-point for upload_ac_results, with
          // the slow-tier (server) write happening async via FastSlowStore.
          // emit_backpressure_enabled=false: AC writes are fire-and-forget
          // post-ack, so MemoryStoreAtCapacity backpressure isn't useful here.
          "memory": {
            "eviction_policy": {
              "max_bytes": 100000000,
              "max_count": 100000
            },
            "emit_backpressure_enabled": false
          }
        },
        "slow": {
          "grpc": {
            "instance_name": "main",
            "endpoints": [
              {
                "address": "grpcs://cache.example.com:50071",
                "use_http3": false,
                "tls_config": {
                  "cert_file": "/Users/user/Work/nativelink/tls/worker.crt",
                  "key_file": "/Users/user/Work/nativelink/tls/worker.key",
                  "use_native_roots": true
                }
              }
            ],
            "connections_per_endpoint": 32,
            // Per-chunk no-progress timer (seconds) for ByteStream.Write.
            // 15s = enough headroom for slow-but-progressing producers
            // while still terminating wedged transports promptly.
            "rpc_timeout_s": 15,
            // "zstd_compression": true, // disabled: QUIC zero-copy codec can't decompress
            "store_type": "ac",
            "retry": {
              "max_retries": 5,
              "delay": 0.5,
              "jitter": 0.5
            }
          }
        }
      }
    },
    {
      "name": "WORKER_FAST_SLOW_STORE",
      "fast_slow": {
        "fast": {
          "filesystem": {
            "content_path": "/Users/user/Work/nativelink/data-worker-test/content_path-cas",
            "temp_path": "/Users/user/Work/nativelink/data-worker-test/tmp_path-cas",
            "eviction_policy": {
              // 40 GiB
              "max_bytes": 40000000000,
              // FL-681: pin budget = 50% of max_bytes (20 GiB) so a worker can
              // hold more pending-BIS output durability pins under load before
              // the admission NAK fires (at 95% of this). Unset = 25% default.
              "pin_cap_bytes": 20000000000
            },
            // CAS is content-addressed: identical key ⇒ identical content,
            // so a duplicate write is a no-op. Skipping it avoids the
            // tempfile + rename + index-update churn under upload bursts.
            // SAFE only for CAS; NEVER set on AC (same key can hold
            // different content).
            "content_is_immutable": true,
            // FL-688 v3 Stage C: arm the startup reconcile gate so the boot
            // overshoot drain cannot evict blobs the server will request via
            // reconcile (UploadMissingBlobs) before they are reconcile-pinned.
            // WORKER stores ONLY — NEVER set on the server's CAS slow tier
            // (no ReconcileComplete ⇒ eviction suppressed forever). Inert
            // (default false) if absent; worker logs "startup reconcile gate
            // ARMED" at boot when set.
            "startup_reconcile_gate": true
          }
        },
        "slow": {
          "grpc": {
            "instance_name": "main",
            "endpoints": [
              {
                // QUIC/HTTP3 endpoint (dual_transport uses endpoints[0] for QUIC)
                // Server uses self-signed ECDSA cert for QUIC (not Sectigo RSA).
                // Trust it explicitly via ca_file instead of native roots.
                "address": "grpcs://cache.example.com:50072",
                "use_http3": true,
                "tls_config": {
                  "cert_file": "/Users/user/Work/nativelink/tls/worker.crt",
                  "key_file": "/Users/user/Work/nativelink/tls/worker.key",
                  "ca_file": "/Users/user/Work/nativelink/tls/quic-server.crt",
                  "use_native_roots": false
                }
              },
              {
                // TCP/HTTP2 endpoint (dual_transport routes parallel reads + large writes here)
                "address": "grpcs://cache.example.com:50071",
                "use_http3": false,
                "tls_config": {
                  "cert_file": "/Users/user/Work/nativelink/tls/worker.crt",
                  "key_file": "/Users/user/Work/nativelink/tls/worker.key",
                  "use_native_roots": true
                }
              }
            ],
            "connections_per_endpoint": 32,
            "dual_transport": true,
            // Per-chunk no-progress timer (seconds) for ByteStream.Write.
            // 15s = enough headroom for slow-but-progressing producers
            // while still terminating wedged transports promptly.
            "rpc_timeout_s": 15,
            // "zstd_compression": true, // disabled: QUIC zero-copy codec can't decompress
            "store_type": "cas",
            "retry": {
              "max_retries": 5,
              "delay": 0.5,
              "jitter": 0.5
            },
            // #212 Phase 2.4 worker-side WriteChunked client. Routes
            // CAS blobs >= CHUNK_SIZE (1 MiB) through
            // chunked::chunked_client::write_chunked_stream to the
            // server's WorkerApi/WriteChunked RPC instead of the
            // legacy in-order ByteStream.Write path.
            // Production sign-off 2026-05-02.
            "chunked_writes_enabled": true
          }
        }
      }
    },
    {
      // FL-1383 (#2497): grpc store to the server's incr_seed_index AC instance
      // (:50071). The worker FETCHES the current -incr pointer (GetActionResult
      // on hash(targetkey)) before rustc and PUBLISHES it (update_oneshot) on a
      // successful allowlisted action. Best-effort: a miss/error => cold build.
      "name": "INCR_SEED_INDEX_STORE",
      "grpc": {
        "instance_name": "incr_seed_index",
        "endpoints": [
          {
            "address": "grpcs://cache.example.com:50071",
            "use_http3": false,
            "tls_config": {
              "cert_file": "/Users/user/Work/nativelink/tls/worker.crt",
              "key_file": "/Users/user/Work/nativelink/tls/worker.key",
              "use_native_roots": true
            }
          }
        ],
        "connections_per_endpoint": 8,
        "rpc_timeout_s": 15,
        "store_type": "ac",
        "retry": {
          "max_retries": 3,
          "delay": 0.5,
          "jitter": 0.5
        }
      }
    }
  ],
  "schedulers": [
    {
      "name": "MAIN_SCHEDULER",
      "simple": {
        "supported_platform_properties": {
          "cpu_count": "minimum",
          "memory_kb": "minimum",
          "network_kbps": "minimum",
          "disk_read_iops": "minimum",
          "disk_read_bps": "minimum",
          "disk_write_iops": "minimum",
          "disk_write_bps": "minimum",
          "shm_size": "minimum",
          "gpu_count": "minimum",
          "gpu_model": "exact",
          "cpu_vendor": "exact",
          "cpu_arch": "exact",
          "cpu_model": "priority",
          "kernel_version": "priority",
          "OSFamily": "priority",
          "container-image": "priority"
        }
      }
    }
  ],
  "workers": [
    {
      "local": {
        "worker_api_endpoint": {
          "uri": "grpcs://cache.example.com:50061",
          "tls_config": {
            "use_native_roots": true,
            "cert_file": "/Users/user/Work/nativelink/tls/worker.crt",
            "key_file": "/Users/user/Work/nativelink/tls/worker.key"
          }
        },
        "cas_fast_slow_store": "WORKER_FAST_SLOW_STORE",
        "upload_action_result": {
          "ac_store": "AC_MAIN_STORE"
        },
        // FL-1383 (#2497): portable rustc-incremental. Fetches the fleet-shared
        // -incr seed into a byte-identical fixed execroot before rustc and
        // publishes the produced -incr on success. Fail-closed: only actions
        // whose primary output matches action_output_allowlist opt in;
        // provision_and_assert is fail-safe (a bad prefix/sysroot disables the
        // feature, never panics the worker).
        "portable_incr": {
          "enabled": true,
          "action_output_allowlist": ["bazel-out/"]
        },
        "portable_incr_fixed_prefix": "/Volumes/CrowAgent/fl-incr-execroots",
        "portable_incr_sysroot_path": "/Users/user/.rustup/toolchains/nightly-2026-04-25-aarch64-apple-darwin",
        "portable_incr_seed_index_store": "INCR_SEED_INDEX_STORE",
        "work_directory": "/Users/user/Work/nativelink/work",
        "cas_server_port": 40081,
        // #F2: deferred output uploads — completes actions once outputs are
        // local+pinned+locality-advertised; spawn_upload_to_remote backfills
        // remote durability. Requires cas_server_port (set above) + Bazel
        // --remote_retries>=1 (=10). Enabled 2026-06-14 after the F2 cadre
        // sign-off + 21h prod bake of the supporting fixes.
        "deferred_output_uploads_enabled": true,
        // #64 memory-gate ENABLED FLEET-WIDE 2026-06-29 after a ~15h single-worker
        // canary (worker-07) + synthetic-pressure validation: no free-floor
        // false-trip at available 2.8GiB/raw_free 24MiB (old raw-free gate would
        // have stormed); zero NAKs across all load windows. Free-floor PRIMARY
        // (available = free+inactive+purgeable < 1GiB). Refault CORROBORATION at
        // 10000/s: measured busy baseline peaks ~896/s (11x under) + heavy
        // synthetic thrash ~1800 EWMA, so refault is a high-bar safety net that
        // ~never fires in practice. Fleet-wide fail-open prevents correlated NAK
        // storms. Revert: set memory_gate_enabled false + push-config + restart.
        "memory_gate_enabled": true,
        // #64 REFAULT PATH SUPPRESSED 2026-06-30 (mis-calibrated under build load: 10000
        // idle-tuned, rf_nak fired on 8/10 workers during --config=dbg builds; free-floor
        // path stays ON + clean). u32::MAX = refault never confirms = free-floor-only (the
        // 15h-canary-validated config). NOTE: as of the two-signal re-key this field is the
        // DEPRECATED/unwired back-compat field (retained so deny_unknown_fields accepts this
        // config); the refault EWMA is replaced by the sustained-swapin gate below.
        "memory_gate_refault_confirm_rate": 4294967295,
        // TWO-SIGNAL re-key 2026-07-16: OOM hard-NAK is SUSTAINED SWAPINS (disk spill,
        // strictly deeper than compression). ARMED 2026-07-29 at a MEASURED threshold:
        // restart-fresh calibration over a benchmark burst (self-recording maxes+bands,
        // #calib) showed fleet-max 960 pages/s with 98.5% of ticks at 0 and only 2 ticks
        // fleet-wide in the 1k-10k band — and REFUTED the old "baseline is always 0" claim
        // (post-restart swapin bursts are real). 2000 = ~2x the busiest observed max, an
        // order below genuine sustained disk-thrash; the sustained-10-tick confirm window
        // filters blips. Armed TOGETHER with phase3_overcommit_max_factor 2.0->4.0 (the
        // proactive floor loosens only with this reactive backstop live). Free-floor NAK
        // remains the fail-safe. Kill: set back to 4294967295 + restart workers.
        "memory_gate_swapin_confirm_rate": 2000,
        "cas_server_tls": {
          "cert_file": "/Users/user/Work/nativelink/tls/worker.crt",
          "key_file": "/Users/user/Work/nativelink/tls/worker.key"
        },
        "pprof_port": 6061,
        "directory_cache": {
          "max_entries": 10000,
          "max_size_bytes": "40GB",
          "cache_root": "/Users/user/Work/nativelink/directory_cache"
        },
        "platform_properties": {
          "cpu_count": {
            "values": [
              "10"
            ]
          },
          "memory_kb": {
            "values": [
              "16000000"
            ]
          },
          "network_kbps": {
            "values": [
              "10000000"
            ]
          },
          "cpu_arch": {
            "values": [
              "arm64"
            ]
          },
          "OSFamily": {
            "values": [
              "macos"
            ]
          },
          "container-image": {
            "values": [
              ""
            ]
          }
        }
      }
    }
  ],
  "servers": [
    {
      "name": "public",
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50051"
        }
      },
      "services": {
        "cas": [
          {
            "instance_name": "main",
            "cas_store": "WORKER_FAST_SLOW_STORE"
          }
        ],
        "ac": [
          {
            "instance_name": "main",
            "ac_store": "AC_MAIN_STORE"
          }
        ],
        "execution": [
          {
            "instance_name": "main",
            "cas_store": "WORKER_FAST_SLOW_STORE",
            "scheduler": "MAIN_SCHEDULER"
          }
        ],
        "capabilities": [
          {
            "instance_name": "main",
            "remote_execution": {
              "scheduler": "MAIN_SCHEDULER"
            }
          }
        ],
        "bytestream": [
          {
            "instance_name": "main",
            "cas_store": "WORKER_FAST_SLOW_STORE",
            "streaming_read_while_write": true
          }
        ]
      }
    },
    {
      "name": "private_workers_servers",
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50061"
        }
      },
      "services": {
        "worker_api": {
          "scheduler": "MAIN_SCHEDULER"
        },
        "admin": {},
        "health": {},
        // #556: worker-side /metrics scrape for #547 Phase 0 headline
        // metric (phase0_worker_*). Same listener as admin/health/worker_api
        // (0.0.0.0:50061 plain HTTP), so the network surface is unchanged
        // — the listener is already unauthenticated and reachable on the
        // internal LAN. Scrape via the `just scrape-all-workers-phase0`
        // recipe (SSH+curl fan-out across worker_macs.txt).
        "metrics": {}
      }
    }
  ],
  "global": {
    "default_digest_hash_function": "blake3",
    "max_open_files": 24576
  }
}
