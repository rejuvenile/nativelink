{
  "stores": [
    // --- Redis backing stores ---
    {
      "name": "REDIS_AC_STORE",
      "redis_store": {
        "addresses": ["redis+unix:///run/valkey/valkey.sock?db=0"],
        "key_prefix": "ac:",
        "command_timeout_ms": 60000,
        "connection_timeout_ms": 3000,
        "max_client_permits": 16384,
        "connection_pool_size": 64
      }
    },
    {
      "name": "REDIS_CAS_SMALL_STORE",
      "redis_store": {
        "addresses": ["redis+unix:///run/valkey/valkey.sock?db=1"],
        "key_prefix": "cas:",
        "command_timeout_ms": 60000,
        "connection_timeout_ms": 3000,
        "max_client_permits": 16384,
        "connection_pool_size": 64,
        // Match the URL's `db=1` so the keyspace-notifications subscriber
        // listens on the SAME db that PUT/GET commands target.  Without
        // this, the subscriber listens on db=0 and never receives evictions
        // for cas: keys → ECS stale-positive invalidation silently broken.
        // #100 BLOCKER 1 fix (nativelink eb5c15e6) fail-fasts on this
        // mismatch instead of degrading silently.
        "keyspace_notifications_db": 1
      }
    },

    // --- AC store chain ---
    // AC_MAIN_STORE → CompletenessCheckingStore { backend: AC_INNER, cas: cas_STORE }
    // AC_INNER → ExistenceCacheStore(1M) → AC_BACKEND_CACHED (FastSlow Memory→Redis)
    // AC_BACKEND_CACHED puts an in-memory cache in front of Redis to absorb
    // repeated AC has() calls during completeness checking. Without this,
    // every action's completeness check pipelines STRLEN+EXISTS to Redis
    // and queues behind the single multiplexed ConnectionManager (observed
    // 47K WARN + 30K ERROR for slow Redis pipelined ops in a 39-min window).
    {
      "name": "AC_BACKEND_CACHED",
      "fast_slow": {
        "fast": {
          "memory": {
            "eviction_policy": {
              "max_bytes": 4000000000,
              "max_count": 500000
            }
          }
        },
        "slow": {
          "ref_store": {
            "name": "REDIS_AC_STORE"
          }
        }
      }
    },
    // #366: wrap AC chain in ExistenceCacheStore so that Valkey-side AC
    // evictions invalidate stale-positive existence-cache entries via the
    // #100 keyspace-notification dispatcher (REDIS_AC_STORE listens on
    // db=0, the default keyspace_notifications_db; supports_removal_callbacks
    // is true → ECS constructs in non-vulnerable mode).
    //
    // Mirrors the cas_INNER pattern: ECS sits between the
    // CompletenessCheckingStore entry-point and the FastSlow{Memory, Redis}
    // backend. Without this wrap, an AC entry evicted from Valkey under
    // `maxmemory-policy=allkeys-lru` would still register as "present"
    // until the entry was re-fetched, breaking the completeness-checking
    // invariant on the cold-storage half of the chain.
    //
    // 1M entries is a conservative cap: AC entries are far fewer than CAS
    // entries (one per action result, not one per blob), and the live
    // dataset is on the order of 10K-100K. 1M entries × ~32 bytes per
    // existence entry = ~32 MB resident — negligible against the 4 GB
    // AC_BACKEND_CACHED tier already in place.
    {
      "name": "AC_INNER",
      "existence_cache": {
        "backend": {
          "ref_store": {
            "name": "AC_BACKEND_CACHED"
          }
        },
        "eviction_policy": {
          "max_count": 1000000
        }
      }
    },
    {
      "name": "AC_MAIN_STORE",
      "completeness_checking": {
        "backend": {
          "ref_store": {
            "name": "AC_INNER"
          }
        },
        "cas_store": {
          "ref_store": {
            "name": "cas_STORE"
          }
        }
      }
    },

    // --- CAS store chain ---
    // Large CAS blobs (>16KB): MemoryStore(32GB) + FilesystemStore
    {
      "name": "cas_FAST_SLOW_STORE",
      "fast_slow": {
        "fast": {
          "memory": {
            "eviction_policy": {
              // 2026-05-12: 48 GB → 16 GB. Recurring OOMs at 65-70 GiB
              // anon-RSS (5 kills 2026-05-05 → 2026-05-12, all global oom
              // triggered by co-resident pressure with kernel selecting
              // nativelink due to oom_score_adj=1000) traced to this
              // MemoryStore + mimalloc retention overhead. Slow tier is
              // local FilesystemStore on the tank pool with ZFS ARC
              // 66-106 GiB absorbing displaced hits — cache-hit-ratio
              // impact bounded by the ARC's hot working set rather than
              // this cap.
              //
              // 2026-05-13: Added evict_bytes: 4.5 GB (= pin_cap 4 GB +
              // 0.5 GB margin for max admission size). Shrinks moka's
              // effective max_capacity to 11.5 GB, leveraging moka's
              // built-in strict-LRU eviction (EvictionPolicy::lru() set
              // at moka_evicting_map.rs:375). With pinned_bytes ≤ pin_cap
              // = max_bytes × 0.25 = 4 GB and weighted_size ≤ 11.5 GB,
              // total ≤ 15.5 GB < max_bytes = 16 GB; gate at
              // memory_store.rs:check_backpressure_gate never fires
              // false-positive on at-cap regardless of admission size up
              // to 0.5 GB. Restores explicit-eviction corner of the
              // gate/pin/evict composability triangle (CLAUDE.md).
              // Falsifies Finding-5-C sweeper proposal (1617 LoC, 4
              // reviewer BLOCKs) — moka's built-in strict-LRU is the
              // load-bearing mechanism; sweeper's iter()-based eviction
              // is "arbitrary order, NOT LRU" per moka docs. Verified by
              // red-team R1 + moka source audit at
              // .claude/reviews/463-c-sweeper/.
              "max_bytes": 16000000000,
              "evict_bytes": 4500000000,
              "max_count": 1000000
            },
            // #212 Phase 2.6 emit BackpressureSignal::MemoryStoreAtCapacity
            // instead of silent eviction at capacity.
            // Production sign-off 2026-05-02.
            "emit_backpressure_enabled": true
          }
        },
        "slow": {
          "filesystem": {
            "content_path": "/srv/casdata/nativelink/stores/content_path-cas",
            "temp_path": "/srv/casdata/nativelink/stores/tmp_path-cas",
            "eviction_policy": {
              "max_bytes": 800000000000
            },
            // CAS is content-addressed: identical key ⇒ identical content,
            // so a duplicate write is a no-op. Skipping it avoids the
            // tempfile + rename + index-update churn under upload bursts.
            // SAFE only for CAS; NEVER set on AC (same key can hold
            // different content).
            "content_is_immutable": true
          }
        },
        // #212 Phase 2.5 chunked-read cascade pin lookup. Activates
        // the design §6.3 step 2 read cascade against the
        // ChunkedReadRegistry installed at server startup.
        // Production sign-off 2026-05-02.
        "chunked_reads_enabled": true,
        // #334 Fix B: per-FastSlowStore in_flight_slow_writes cap.
        // Default in nativelink-config is 0 = uncapped (red-team #1 —
        // workers MUST inherit "uncapped" since this on a 16-32 GiB
        // worker is too large a fraction of host RAM); server
        // explicitly opts in.
        // 2026-05-12: 8 GiB → 12 GiB. Paired with the 48 GB → 16 GB
        // MemoryStore reduction above: less fast-tier cache means more
        // writes hit the slow tier, so the in-flight buffer needs more
        // headroom to absorb burst before backpressure fires. 12 GiB ≈
        // 9.6 s of unrelieved slow-tier pressure at 10 GbE line rate;
        // net config delta is -28 GiB peak (-32 fast +4 in-flight).
        "slow_writes_in_flight_max_bytes": 12884901888
      }
    },
    // cas_VERIFY → VerifyStore (reject uploads where content hash ≠ digest)
    //   → cas_INNER (ExistenceCacheStore → SizePartitioningStore)
    {
      "name": "cas_STORE",
      "verify": {
        "backend": {
          "ref_store": {
            "name": "cas_INNER"
          }
        },
        "verify_size": true,
        "verify_hash": true
      }
    },
    // MemoryStore cache in front of Redis for small CAS blobs.
    // Absorbs repeated reads (directory protos, small source files)
    // that would otherwise flood Redis with individual GETRANGE calls.
    // 4GB / 500K entries — small blobs are ≤16KB, so 4GB holds ~250K+.
    {
      "name": "SMALL_CAS_CACHED",
      "fast_slow": {
        "fast": {
          "memory": {
            "eviction_policy": {
              "max_bytes": 4000000000,
              "max_count": 500000
            }
          }
        },
        "slow": {
          "ref_store": {
            "name": "REDIS_CAS_SMALL_STORE"
          }
        }
      }
    },
    // cas_INNER → ExistenceCacheStore(50M) → SizePartitioningStore:
    //   ≤16KB → SMALL_CAS_CACHED (MemoryStore → Redis)
    //   >16KB → cas_FAST_SLOW_STORE (MemoryStore → FilesystemStore)
    {
      "name": "cas_INNER",
      "existence_cache": {
        "backend": {
          "size_partitioning": {
            "size": 16384,
            "lower_store": {
              "ref_store": {
                "name": "SMALL_CAS_CACHED"
              }
            },
            "upper_store": {
              "ref_store": {
                "name": "cas_FAST_SLOW_STORE"
              }
            }
          }
        },
        "eviction_policy": {
          "max_count": 50000000
        }
      }
    }
  ],
  "schedulers": [
    {
      "name": "MAIN_SCHEDULER",
      "simple": {
        "cas_store": "cas_STORE",
        "supported_platform_properties": {
          "cpu_count": "minimum",
          "memory_kb": "minimum",
          "network_kbps": "minimum",
          "disk_read_iops": "minimum",
          "disk_read_bps": "minimum",
          "disk_write_iops": "minimum",
          "disk_write_bps": "minimum",
          "shm_size": "minimum",
          "gpu_count": "minimum",
          "gpu_model": "exact",
          "cpu_vendor": "exact",
          "cpu_arch": "exact",
          "cpu_model": "exact",
          "kernel_version": "exact",
          "OSFamily": "exact",
          "container-image": "priority",
          "lre-rs": "priority",
          // Bazel >= 9.0 attaches these automatically on persistent-
          // worker-eligible actions. Scheduler commit 8f52b8aa promoted
          // unknown properties from silently-dropped to terminal
          // FailedPrecondition; without an explicit ignore here every
          // such action gets rejected and Bazel surfaces them as
          // "Unknown platform property 'persistentWorkerProtocol'".
          // We don't dispatch on these; mark ignore so the scheduler
          // accepts the action and matches purely on the cpu/os/etc.
          // properties above. (Production outage 2026-05-12.)
          "persistentWorkerProtocol": "ignore",
          "persistentWorkerKey": "ignore"
        }
      }
    }
  ],
  "workers": [],
  "servers": [
    {
      "name": "public",
      "listener": {
        "http": {
          "socket_address": "[::]:50051",
          "advanced_http": {
            "experimental_http2_max_frame_size": 4194304,
            // Bazel clients send bursts of >20 RST_STREAM on TLS reconnect
            // (cancelling stale ByteStream reads from the prior session).
            // The h2 default of 20 trips ENHANCE_YOUR_CALM GoAway, severing
            // the connection mid-stream and leaving the scheduler in a
            // wedged state (observed twice on 2026-04-22). Bumped to 256.
            "experimental_http2_max_pending_accept_reset_streams": 256,
            // h2 keepalive (seconds). Without these, hyper sends NO PING
            // frames and dead-client detection falls to TCP keepalive
            // (Linux default 7200s = 2h). 30s interval = server sends PING
            // after 30s of no inbound activity (active uploads reset the
            // counter, so PING never fires mid-stream). 20s timeout = if
            // PING goes unacknowledged for 20s, server tears down the
            // connection. Bounded dead-client detection at ~50s. Matches
            // gRPC's recommended KEEPALIVE_TIME_MS=30000 /
            // KEEPALIVE_TIMEOUT_MS=20000 defaults.
            "http2_keep_alive_interval": 30,
            "experimental_http2_keep_alive_timeout": 20,
            // #394 (chunked-write admission p99): hyper defaults to a fixed
            // 16 MiB h2 stream-level INITIAL_WINDOW_SIZE with no eager
            // WINDOW_UPDATE pacing. Bazel uploading 50-118 MiB blobs over
            // 1 ms RTT 10 GbE exhausts the window after the first 16 MiB and
            // then waits 5-7 s for WINDOW_UPDATE, producing the
            // `buf_channel.rs:671` "slow producer (>5s wait)" WARNs at
            // bytes_received = 16 MiB exactly. Effective rate ~11-16 MiB/s
            // = ~1% of link. Enabling adaptive_window switches hyper to
            // dynamic BDP-based sizing (up to 64 MiB cap) and eager
            // WINDOW_UPDATE emission. Per-listener change; same setting is
            // mirrored on worker_cas and private_workers_servers below.
            // See `.claude/audits/394-admission-p99-investigation-20260512.md`.
            // Reversible: delete the line + restart.
            "experimental_http2_adaptive_window": true
          },
          // 64 MiB — some Rust crate actions (regex-syntax, serde_core) produce
          // gRPC messages >4 MiB, exceeding the tonic default of 4 MiB.
          "max_decoding_message_size": 67108864,
"require_tls": true,
          "tls": {
            "cert_file": "/srv/gitforge/custom/https/fullchain.pem",
            "key_file": "/srv/gitforge/custom/https/privkey.pem",
            "client_ca_file": "/srv/casdata/nativelink/tls/ca.crt"          }
        }
      },
      "services": {
        "cas": {
          "main": {
            "cas_store": "cas_STORE"
          }
        },
        "ac": {
          "main": {
            "ac_store": "AC_MAIN_STORE"
          }
        },
        "execution": {
          "main": {
            "cas_store": "cas_STORE",
            "scheduler": "MAIN_SCHEDULER"
          }
        },
        "capabilities": {
          "main": {
            "remote_execution": {
              "scheduler": "MAIN_SCHEDULER"
            }
          }
        },
        "bytestream": {
          "cas_stores": {
            "main": "cas_STORE"
          },
          "streaming_read_while_write": true
        }
      }
    },
    {
      // Worker-facing CAS/AC/bytestream on a separate port with a higher
      // encoding limit.  Bazel's Java gRPC client needs ≤4 MiB responses,
      // but NativeLink workers accept up to 256 MiB.
      "name": "worker_cas",
      "listener": {
        "http": {
          "socket_address": "[::]:50071",
          "advanced_http": {
            "experimental_http2_max_frame_size": 4194304,
            // Bazel clients send bursts of >20 RST_STREAM on TLS reconnect
            // (cancelling stale ByteStream reads from the prior session).
            // The h2 default of 20 trips ENHANCE_YOUR_CALM GoAway, severing
            // the connection mid-stream and leaving the scheduler in a
            // wedged state (observed twice on 2026-04-22). Bumped to 256.
            "experimental_http2_max_pending_accept_reset_streams": 256,
            // h2 keepalive (seconds). See public:50051 for full rationale.
            // 30s interval / 20s timeout = ~50s dead-connection detection
            // for the worker CAS path; without these we rely on TCP
            // keepalive (Linux default 2h).
            "http2_keep_alive_interval": 30,
            "experimental_http2_keep_alive_timeout": 20,
            // #394 (chunked-write admission p99): see public:50051 for full
            // rationale. Worker CAS uploads share the same h2 window
            // mechanism; 16 MiB fixed window starves throughput on
            // worker->server CAS PUTs in the same way. Enable adaptive
            // window sizing here too.
            // See `.claude/audits/394-admission-p99-investigation-20260512.md`.
            "experimental_http2_adaptive_window": true
          },
          "max_decoding_message_size": 67108864,
          // 64 MiB — workers set max_decoding to 256 MiB, so 64 MiB
          // encoding is safe and avoids the 4 MiB Bazel constraint.
          "max_encoding_message_size": 67108864,
          // Zstd compression for worker<->server traffic. Source files
          // compress ~4:1, saving 10-80ms per action on 10GbE. Workers'
          // M4 Mac Mini CPUs decompress zstd at ~3GB/s (negligible overhead).
          "compression": {
            "send_compression_algorithm": "zstd",
            "accepted_compression_algorithms": ["zstd"]
          },
"require_tls": true,
          "tls": {
            "cert_file": "/srv/gitforge/custom/https/fullchain.pem",
            "key_file": "/srv/gitforge/custom/https/privkey.pem",
            "client_ca_file": "/srv/casdata/nativelink/tls/ca.crt"          }
        }
      },
      "services": {
        "cas": {
          "main": {
            "cas_store": "cas_STORE"
          }
        },
        "ac": {
          "main": {
            "ac_store": "AC_MAIN_STORE"
          }
        },
        "bytestream": {
          "cas_stores": {
            "main": "cas_STORE"
          },
          "streaming_read_while_write": true
        }
      }
    },
    {
      // Worker-facing CAS/AC/bytestream over QUIC/HTTP3 (UDP).
      // Same services as worker_cas but using QUIC for lower latency
      // and better multiplexing on the 10 GbE LAN.
      "name": "worker_cas_quic",
      "listener": {
        "http3": {
          "socket_address": "[::]:50072",
          "cert_file": "/srv/nativelink/certs/server.crt",
          "key_file": "/srv/nativelink/certs/server.key",
          "client_ca_file": "/srv/casdata/nativelink/tls/ca.crt",
          "max_decoding_message_size": 67108864,
          "max_encoding_message_size": 67108864
        }
      },
      "services": {
        "cas": {
          "main": {
            "cas_store": "cas_STORE"
          }
        },
        "ac": {
          "main": {
            "ac_store": "AC_MAIN_STORE"
          }
        },
        "bytestream": {
          "cas_stores": {
            "main": "cas_STORE"
          },
          "streaming_read_while_write": true
        }
      }
    },
    {
      "name": "private_workers_servers",
      "listener": {
        "http": {
          "socket_address": "[::]:50061",
          "max_encoding_message_size": 67108864,
          "advanced_http": {
            "experimental_http2_max_frame_size": 4194304,
            // Bazel clients send bursts of >20 RST_STREAM on TLS reconnect
            // (cancelling stale ByteStream reads from the prior session).
            // The h2 default of 20 trips ENHANCE_YOUR_CALM GoAway, severing
            // the connection mid-stream and leaving the scheduler in a
            // wedged state (observed twice on 2026-04-22). Bumped to 256.
            "experimental_http2_max_pending_accept_reset_streams": 256,
            // h2 keepalive (seconds). See public:50051 for full rationale.
            // Worker API connections are long-lived; without keepalive a
            // dead worker socket lingers up to TCP keepalive's 2h. 30s
            // interval / 20s timeout caps detection at ~50s.
            "http2_keep_alive_interval": 30,
            "experimental_http2_keep_alive_timeout": 20,
            // #394 (chunked-write admission p99): see public:50051 for full
            // rationale. The worker_api listener carries scheduler RPCs and
            // is less sensitive to large-blob window starvation, but the
            // setting is harmless and keeps all three h2 listeners aligned
            // (every stream on every hyper listener inherits the same
            // window-sizing config).
            // See `.claude/audits/394-admission-p99-investigation-20260512.md`.
            "experimental_http2_adaptive_window": true
          },
          "require_tls": true,
          "tls": {
            "cert_file": "/srv/gitforge/custom/https/fullchain.pem",
            "key_file": "/srv/gitforge/custom/https/privkey.pem",
            "client_ca_file": "/srv/casdata/nativelink/tls/ca.crt"          }
        }
      },
      "services": {
        // Note: This should be served on a different port, because it has
        // a different permission set than the other services.
        // In other words, this service is a backend api. The ones above
        // are a frontend api.
        "worker_api": {
          "scheduler": "MAIN_SCHEDULER"
        },
        "admin": {},
        "health": {},
        // RE-ENABLED 2026-05-15 after `a169e482` (2026-05-13 18:39 PDT)
        // fixed the blanket-impl wedge — that commit added try_*_lock
        // skip-on-contention to all four `MetricsComponent for
        // {std,parking_lot,tokio::sync,async_lock}::{Mutex,RwLock}<T>`
        // blankets, so a metrics scrape that races a scheduler writer
        // publishes a default Component for the contended subtree
        // instead of parking the tokio worker on the FIFO event_listener
        // queue. Commit message explicitly states: "Re-enabling
        // services.metrics: {} in production after this commit ships
        // will no longer wedge the server." Confirmed live on origin/main
        // 2026-05-15 12:37 PDT (PID 1867529). Original wedge-2026-05-13
        // RCA at .claude/audits/wedge-2026-05-13-postmortem.md.
        // Worker API (50061) is mTLS-narrowed to internal fleet (per
        // memory `remote_workers_are_trusted`), so /metrics scrape
        // audience is operator + the internal worker / crow-agent /
        // buildbuddy / user cert holders only.
        "metrics": {}
      }
    }
  ],
  "global": {
    "max_open_files": 524288,
    default_digest_hash_function: "blake3",
    pprof_port: 6060,
    // TLS config for server → worker CAS connections (port 40081).
    // The CA that signed the worker certificates.
    worker_proxy_tls_ca_file: "/srv/casdata/nativelink/tls/ca.crt",
    // Server's client cert/key for mTLS to workers.
    worker_proxy_tls_cert_file: "/srv/gitforge/custom/https/fullchain.pem",
    worker_proxy_tls_key_file: "/srv/gitforge/custom/https/privkey.pem",
    // #212 Phase 2.7 Bazel-facing internal-chunking kill-switch.
    // When ON, FastSlowStore::update for blobs >= CHUNK_SIZE (1 MiB)
    // dispatches via the per-blob ChunkedDriver machinery (β
    // async-commit semantics) instead of the legacy single-stream
    // path. Process-wide AtomicBool consulted by every FSS that
    // has a BazelChunkedDispatcher installed.
    // Production sign-off 2026-05-02.
    bazel_facing_internal_chunking_enabled: true,
    // #168 SmallBlobDispatcher kill-switch. RE-ENABLED 2026-05-06
    // (10:00am PDT) after the v2-canary "rollback" investigation
    // exonerated v2: the original "sent too much data" errors were
    // a Bazel-side cache corruption (LF/CRLF or similar 79-byte drift
    // on `scopeguard-1.2.0/src/lib.rs`) that persisted across the v2
    // → af8c0b53 server-binary rollback. Server was correctly
    // rejecting an invalid upload; user cleared Bazel cache to fix.
    // v2 binary is healthy; turning the canary flag back on.
    small_blob_mirror_enabled: true
  }
}
